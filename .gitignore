env/
venv/
ENV/
*.venv

# Arquivos de variáveis de ambiente e segredos
.env
.env.*
!.env.example

# Bytecode e cache do Python
__pycache__/
*.py[cod]
*$py.class
*.so
# Modelos e Pesos
*.pt
*.onnx

# Diretórios de dados e outputs
data/datasets/
data/pseudo/
data/input/
data/output/

# Cache de detecções e imagens de validação (regeneráveis; CSVs e
