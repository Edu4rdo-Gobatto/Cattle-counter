cache/
validation/*.png

# Treino (pesos gerados e datasets baixados são regeneráveis)
runs/

# Vídeos e gravações (arquivos binários pesados)
*.mp4
*.avi
*.mov
*.mkv

# Configurações de IDE e editores
.vscode/
.idea/
.DS_Store
Thumbs.db
